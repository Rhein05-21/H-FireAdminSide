# ============================================================
# H-FIRE ADMIN MONITORING - ENVIRONMENT CONFIGURATION
# ============================================================

# 1. Supabase Backend (Auth, Database & Realtime)
# Replace with your project credentials from https://app.supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. HiveMQ Cloud MQTT Broker (For ESP32 IoT Nodes)
EXPO_PUBLIC_HIVEMQ_BROKER=your-cluster-id.s1.eu.hivemq.cloud
EXPO_PUBLIC_HIVEMQ_PORT=8884
EXPO_PUBLIC_HIVEMQ_USERNAME=hfire_admin
EXPO_PUBLIC_HIVEMQ_PASSWORD=your-hivemq-password

# 3. Server Port for Bridge Healthcheck
PORT=8080
