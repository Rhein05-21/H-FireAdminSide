{
  "expo": {
    "name": "H-Fire Admin",
    "slug": "h-fireadminmonitoring",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/h-fire_logo.png",
    "scheme": "hfireadmin",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/h-fire_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyC43FblIwS4qhG0t1ss4fLRDot-NNp7-WU"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/h-fire_logo.png",
        "backgroundColor": "#0B0F19"
      },
      "package": "com.hfire.admin",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC43FblIwS4qhG0t1ss4fLRDot-NNp7-WU"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/h-fire_logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow H-Fire Admin to use your location for the community safety map."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/634392a5-65a6-4b1b-af6c-41c3d7ecea78"
    },
    "extra": {
      "eas": {
        "projectId": "634392a5-65a6-4b1b-af6c-41c3d7ecea78"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
